# Sao chép thành .env rồi sửa giá trị
MYSQL_ROOT_PASSWORD=root
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

DEFAULT_TENANT=tigernet
TENANTS=tigernet

EUREKA_URL=http://discovery-server:8761/eureka
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
MAIL_HOST=mailpit
MAIL_PORT=1025

# Local: giữ profile dev (khóa dev mặc định + tài khoản demo). Môi trường thật: XÓA dòng này và đặt 2 khóa bên dưới.
SPRING_PROFILES_ACTIVE=dev
# Bắt buộc khi không dùng profile dev. Sinh khóa: openssl rand -base64 48
# JWT_SECRET=
# INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Thời hạn token (identity-service)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Rate limit tại gateway (theo user, chưa đăng nhập thì theo IP)
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40
